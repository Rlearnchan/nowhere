{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/contracts/editorial_memo.schema.json",
  "title": "NOWHERE Editorial Memo",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "title", "one_liner", "summary_bullets", "news_bullets", "stories", "watchpoints", "host_questions", "claim_evidence_map", "approval"],
  "properties": {
    "schema_version": {"const": "editorial_memo.v1"},
    "run_id": {"type": "string"},
    "title": {"type": "string"},
    "one_liner": {"type": "string"},
    "summary_bullets": {"type": "array", "minItems": 3, "maxItems": 6, "items": {"type": "string"}},
    "news_bullets": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "headline", "market_connection"],
        "properties": {
          "event_id": {"type": "string"},
          "headline": {"type": "string"},
          "market_connection": {"type": "string"}
        }
      }
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["story_id", "title", "question", "observed_facts", "interpretation", "counterevidence", "disconfirmation_conditions", "evidence_ids", "confidence"],
        "properties": {
          "story_id": {"type": "string"},
          "title": {"type": "string"},
          "question": {"type": "string"},
          "observed_facts": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "interpretation": {"type": "string"},
          "alternative_hypotheses": {"type": "array", "items": {"type": "string"}},
          "counterevidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "disconfirmation_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "evidence_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "confidence": {"enum": ["low", "medium", "high"]}
        }
      }
    },
    "watchpoints": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "host_questions": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "chart_requests": {"type": "array", "items": {"type": "string"}},
    "claim_evidence_map": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "claim", "claim_type", "evidence_ids"],
        "properties": {
          "claim_id": {"type": "string"},
          "claim": {"type": "string"},
          "claim_type": {"enum": ["observed_fact", "reported_claim", "interpretation", "hypothesis"]},
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["draft", "approved", "rejected", "stale"]},
        "approved_by": {"type": ["string", "null"]},
        "approved_at": {"type": ["string", "null"], "format": "date-time"},
        "notes": {"type": "string"}
      }
    }
  }
}
