{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOWHERE Lightweight Series",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "charts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "nowhere.lightweight_series.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "charts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/chart"
      }
    }
  },
  "definitions": {
    "chart": {
      "type": "object",
      "required": [
        "chart_id",
        "tool",
        "container_hint",
        "series",
        "metadata"
      ],
      "additionalProperties": false,
      "properties": {
        "chart_id": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "const": "lightweight-charts"
        },
        "container_hint": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "object"
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/series"
          }
        },
        "metadata": {
          "$ref": "#/definitions/metadata"
        }
      }
    },
    "series": {
      "type": "object",
      "required": [
        "series_id",
        "type",
        "data",
        "metadata"
      ],
      "additionalProperties": false,
      "properties": {
        "series_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "Candlestick",
            "Line",
            "Area",
            "Bar",
            "Histogram"
          ]
        },
        "data": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "markers": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "source_ids",
        "evidence_ids",
        "rights_classes"
      ],
      "additionalProperties": false,
      "properties": {
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rights_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
