{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/contracts/news_pack.schema.json",
  "title": "NOWHERE News Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "news_cutoff",
    "events",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "news_pack.v1"
    },
    "run_id": {
      "type": "string"
    },
    "news_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "events": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "first_seen_at",
          "title",
          "category",
          "facts",
          "sources",
          "market_links",
          "status"
        ],
        "properties": {
          "event_id": {
            "type": "string"
          },
          "first_seen_at": {
            "type": "string",
            "format": "date-time"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tickers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fact_id",
                "text",
                "source_ids"
              ],
              "properties": {
                "fact_id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "source_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "reported_claims": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "market_links": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "confirmed",
              "partially_confirmed",
              "unverified"
            ]
          },
          "significance_hint": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "open_questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quality_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rights_class": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "name",
          "url",
          "published_at",
          "rights_class"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "rights_class": {
            "type": "string"
          }
        }
      }
    }
  }
}
