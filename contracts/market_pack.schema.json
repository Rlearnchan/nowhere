{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/contracts/market_pack.schema.json",
  "title": "NOWHERE Market Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "indices",
    "breadth",
    "flows",
    "fx",
    "global_context",
    "movers",
    "observations",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "market_pack.v1"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "trade_date",
        "generated_at",
        "market_as_of",
        "quality_status",
        "warnings"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "trade_date": {
          "type": "string",
          "format": "date"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "market_as_of": {
          "type": "string",
          "format": "date-time"
        },
        "quality_status": {
          "enum": [
            "ok",
            "review_needed",
            "blocked"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "indices": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/indexObservation"
      }
    },
    "breadth": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/breadthObservation"
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flowObservation"
      }
    },
    "fx": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/valueObservation"
      }
    },
    "global_context": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/valueObservation"
      }
    },
    "movers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "ticker",
          "name",
          "market",
          "last",
          "change_pct",
          "source_id"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "ticker": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "market": {
            "type": "string"
          },
          "last": {
            "type": "number"
          },
          "change_pct": {
            "type": "number"
          },
          "source_id": {
            "type": "string"
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation_id",
          "text",
          "evidence_ids",
          "observation_type"
        ],
        "properties": {
          "observation_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "observation_type": {
            "enum": [
              "observed_fact",
              "derived_metric",
              "data_warning"
            ]
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "sector_rankings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top",
        "bottom"
      ],
      "properties": {
        "top": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sectorRanking"
          }
        },
        "bottom": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sectorRanking"
          }
        }
      }
    },
    "featured_stocks": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/featuredStock"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "name",
        "url",
        "retrieved_at",
        "rights_class"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "rights_class": {
          "enum": [
            "public_official",
            "public_web_restricted",
            "open_source_adapter",
            "internal_licensed",
            "internal_derived",
            "publication_safe"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "indexObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "symbol",
        "name",
        "last",
        "change",
        "change_pct",
        "prev_close",
        "open",
        "high",
        "low",
        "as_of",
        "source_id"
      ],
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "last": {
          "type": "number"
        },
        "change": {
          "type": "number"
        },
        "change_pct": {
          "type": "number"
        },
        "prev_close": {
          "type": "number"
        },
        "open": {
          "type": "number"
        },
        "high": {
          "type": "number"
        },
        "low": {
          "type": "number"
        },
        "recovery_from_low_pct": {
          "type": "number"
        },
        "position_in_range_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "source_id": {
          "type": "string"
        },
        "rights_class": {
          "type": "string"
        },
        "prototype_only": {
          "type": "boolean"
        },
        "redistribution_allowed": {
          "type": "boolean"
        },
        "quality_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "breadthObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "market",
        "advancers",
        "unchanged",
        "decliners",
        "advancer_ratio_ex_flat_pct",
        "as_of",
        "source_id"
      ],
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "market": {
          "type": "string"
        },
        "advancers": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        },
        "decliners": {
          "type": "integer",
          "minimum": 0
        },
        "advancer_ratio_ex_flat_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "source_id": {
          "type": "string"
        }
      }
    },
    "flowObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "market",
        "participant",
        "net_value_krw_100m",
        "as_of",
        "source_id"
      ],
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "market": {
          "type": "string"
        },
        "participant": {
          "enum": [
            "individual",
            "foreign",
            "institution",
            "program_total",
            "program_arbitrage",
            "program_non_arbitrage"
          ]
        },
        "net_value_krw_100m": {
          "type": "number"
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "source_id": {
          "type": "string"
        }
      }
    },
    "valueObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "symbol",
        "name",
        "value",
        "unit",
        "as_of",
        "source_id"
      ],
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "change_pct": {
          "type": "number"
        },
        "change_bp": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "source_id": {
          "type": "string"
        },
        "window_start": {
          "type": "string",
          "format": "date-time"
        },
        "window_end": {
          "type": "string",
          "format": "date-time"
        },
        "point_count": {
          "type": "integer",
          "minimum": 1
        },
        "period": {
          "type": [
            "string",
            "null"
          ]
        },
        "interval": {
          "type": [
            "string",
            "null"
          ]
        },
        "freshness_age_hours": {
          "type": "number",
          "minimum": 0
        },
        "stale_hours": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string"
        },
        "rights_class": {
          "type": "string"
        },
        "quality_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sectorRanking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "market",
        "sector",
        "last",
        "change",
        "change_pct",
        "as_of",
        "source_id"
      ],
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "market": {
          "type": "string"
        },
        "sector": {
          "type": "string"
        },
        "last": {
          "type": "number"
        },
        "change": {
          "type": "number"
        },
        "change_pct": {
          "type": "number"
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "source_id": {
          "type": "string"
        },
        "rights_class": {
          "type": "string"
        },
        "quality_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "featuredStock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "ticker",
        "name",
        "market",
        "last",
        "change",
        "change_pct",
        "as_of",
        "source_id"
      ],
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "ticker": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "market": {
          "type": "string"
        },
        "last": {
          "type": "number"
        },
        "change": {
          "type": "number"
        },
        "change_pct": {
          "type": "number"
        },
        "volume": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "trading_value_krw": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "market_cap_krw": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "market_status": {
          "type": "string"
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "source_id": {
          "type": "string"
        },
        "rights_class": {
          "type": "string"
        },
        "quality_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
